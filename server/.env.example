# Server environment — copy to .env and fill in. NEVER commit the real .env

PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Supabase project
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# Admin panel credentials (used by /api/admin/login)
ADMIN_EMAIL=admin@yourstore.com
ADMIN_PASSWORD=change-this-strong-password

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=paste-generated-secret

# WhatsApp number in international format without "+"
WHATSAPP_NUMBER=91XXXXXXXXXX

# AI chat edge function (optional)
CHAT_FUNCTION_URL=https://your-project.supabase.co/functions/v1/swift-api
